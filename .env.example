# Copy to .env (git-ignored). These are pushed into the Worker with `wrangler secret put`
# (see docs/runbooks/deploy.md step 5); the Worker never reads .env directly.
#
# X app → User authentication settings → OAuth 2.0 Client ID / Client Secret
# (NOT the OAuth 1.0a "API Key and Secret" and NOT the app-only Bearer Token — those cannot read bookmarks)
X_CLIENT_ID=
X_CLIENT_SECRET=
# @BotFather token for the alert bot
TELEGRAM_BOT_TOKEN=
# chat id of the person the bot alerts (docs/runbooks/deploy.md step 8)
TELEGRAM_CHAT_ID=
